#!/usr/bin/env bash
set -euo pipefail

LOG_FILE=".git/ai-commit-hook.log"
log() {
    echo "[$(date -u +'%Y-%m-%dT%H:%M:%SZ')] $*" >> "$LOG_FILE"
}

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

if [[ -n "$COMMIT_SOURCE" ]]; then
    exit 0
fi

if [[ -z "${GROQ_API_KEY:-}" ]]; then
    log "ERROR: GROQ_API_KEY is not set."
    exit 0
fi

log "--- NEW COMMIT (AUTO-DISCOVER MODEL via GROQ) ---"
DIFF=$(git diff --cached --unified=3 -- . ':(exclude)*.lock' ':(exclude)package-lock.json')

if [[ -z "$DIFF" ]]; then
    log "Diff is empty, exiting."
    exit 0
fi

MAX_CHARS=12000
if [[ ${#DIFF} -gt $MAX_CHARS ]]; then
    DIFF="${DIFF:0:$MAX_CHARS}"
fi

RECENT_LOG=$(git log --oneline -5 2>/dev/null || echo "")

log "Fetching alive models from Groq..."
MODELS_JSON=$(curl -s -m 5 -H "Authorization: Bearer ${GROQ_API_KEY}" https://api.groq.com/openai/v1/models || echo "{}")

MODEL=$(python3 - "$MODELS_JSON" 2>>"$LOG_FILE" <<'PY_EOF'
import json, sys
try:
    data = json.loads(sys.argv[1])
    models = [m['id'] for m in data.get('data', [])]
    # Ищем любую живую Llama, исключая всякие guard/vision
    llama_models = [m for m in models if 'llama' in m.lower() and 'guard' not in m.lower()]
    if llama_models:
        print(llama_models[-1]) # Берем последнюю добавленную
    elif models:
        print(models[0]) # Если нет ламы, берем вообще любую первую
    else:
        print("mixtral-8x7b-32768")
except:
    print("mixtral-8x7b-32768")
PY_EOF
)
log "Dynamically selected model: $MODEL"

SYSTEM_PROMPT="You are a senior C++ developer. Write a professional git commit message for this diff. Output ONLY the raw commit message text. NO markdown formatting. NO backticks. NO labels like 'What:' or 'Why:'. First line: Imperative summary under 50 chars. Blank line. Then bullet points explaining the core technical changes."

REQUEST_BODY=$(python3 - "$SYSTEM_PROMPT" "$RECENT_LOG" "$DIFF" "$MODEL" 2>>"$LOG_FILE" <<'PY_EOF'
import json, sys
body = {
    "model": sys.argv[4],
    "messages": [
        {"role": "system", "content": sys.argv[1]},
        {"role": "user", "content": f"Context (recent commits):\n{sys.argv[2]}\n\nDiff:\n{sys.argv[3]}"}
    ],
    "temperature": 0.2,
    "max_tokens": 1024
}
print(json.dumps(body))
PY_EOF
)

URL="https://api.groq.com/openai/v1/chat/completions"

RESPONSE=$(curl -s -m 20 "$URL" \
    -H "Authorization: Bearer ${GROQ_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "$REQUEST_BODY" 2>>"$LOG_FILE" || true)

log "Raw API Response: $RESPONSE"

SUGGESTED_MSG=$(python3 - "$RESPONSE" 2>>"$LOG_FILE" <<'PY_EOF'
import json, sys, re
raw = sys.argv[1]
try:
    data = json.loads(raw)
    if "error" in data:
        print(f"API Error: {data['error']}", file=sys.stderr)
        sys.exit(1)

    choice = data['choices'][0]['message']

    # Если модель с reasoning-движком и content пустой - берем текст из reasoning
    text = choice.get('content', '')
    if not text:
        text = choice.get('reasoning', '')

    if not text:
        print("Error: Both content and reasoning are empty", file=sys.stderr)
        sys.exit(1)

    text = re.sub(r'^```[\w]*\n', '', text)
    text = re.sub(r'```$', '', text)
    print(text.strip())
except Exception as e:
    print(f"Parse Error: {e}", file=sys.stderr)
    sys.exit(1)
PY_EOF
)

if [[ -z "$SUGGESTED_MSG" ]]; then
    log "SUGGESTED_MSG is empty. Aborting AI insertion."
    exit 0
fi

{
    echo "$SUGGESTED_MSG"
    echo ""
    cat "$COMMIT_MSG_FILE"
} > "${COMMIT_MSG_FILE}.tmp"

mv "${COMMIT_MSG_FILE}.tmp" "$COMMIT_MSG_FILE"
log "Successfully inserted AI message."
