#!/usr/bin/env bash
#
# prepare-commit-msg hook — suggests a commit message via the Gemini API
# based on the staged diff.
#
# Install (from repo root):
#   ln -sf ../../scripts/git-hooks/prepare-commit-msg .git/hooks/prepare-commit-msg
#   chmod +x .git/hooks/prepare-commit-msg
#
# Requires: GEMINI_API_KEY environment variable, curl, python3 (for JSON
# escaping/parsing — avoids a jq dependency).
#
# Skips itself automatically for merges, amends, squashes, and any commit
# where a message was already supplied (e.g. `git commit -m "..."`), so it
# only fires on a plain `git commit` that would otherwise open your editor
# on an empty message.

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

if [[ -n "$COMMIT_SOURCE" ]]; then
    exit 0
fi

if [[ -z "${GEMINI_API_KEY:-}" ]]; then
    echo "note: GEMINI_API_KEY not set, skipping AI commit message suggestion" >&2
    exit 0
fi

DIFF=$(git diff --cached --unified=3 -- . ':(exclude)*.lock' ':(exclude)package-lock.json')

if [[ -z "$DIFF" ]]; then
    exit 0
fi

MAX_CHARS=12000
if [[ ${#DIFF} -gt $MAX_CHARS ]]; then
    DIFF="${DIFF:0:$MAX_CHARS}
[... diff truncated for length ...]"
fi

RECENT_LOG=$(git log --oneline -5 2>/dev/null || echo "")

PROMPT=$(cat <<PROMPT_EOF
You write git commit messages. Given a staged diff, output ONLY the commit
message text — no preamble, no markdown fences, no explanation.

Style:
- First line: concise summary, imperative mood, under 72 chars, no trailing period
- If the change needs more explanation, blank line then a short body
  (wrapped ~72 chars, bullet points with "-" are fine)
- No "Generated by AI" or similar signature
- Match the tone of these recent commits from this repo:
${RECENT_LOG}

Diff:
${DIFF}
PROMPT_EOF
)

MODEL="${GEMINI_MODEL:-gemini-flash-lite-latest}"
URL="https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent"

REQUEST_BODY=$(python3 - "$PROMPT" <<'PY_EOF'
import json
import sys

prompt = sys.argv[1]
body = {
    "contents": [{"parts": [{"text": prompt}]}],
    "generationConfig": {"maxOutputTokens": 300},
}
print(json.dumps(body))
PY_EOF
)

RESPONSE=$(curl -s -m 20 "${URL}?key=${GEMINI_API_KEY}" \
    -H "content-type: application/json" \
    -d "$REQUEST_BODY" || true)
SUGGESTED_MSG=$(python3 - "$RESPONSE" <<'PY_EOF'
import json
import sys

raw = sys.argv[1]
try:
    data = json.loads(raw)
    candidates = data.get("candidates", [])
    parts = candidates[0].get("content", {}).get("parts", []) if candidates else []
    text = "".join(p.get("text", "") for p in parts)
    print(text.strip())
except Exception:
    pass
PY_EOF
)

if [[ -z "$SUGGESTED_MSG" ]]; then
    echo "note: could not get a suggested commit message, opening editor as usual" >&2
    exit 0
fi

{
    echo "$SUGGESTED_MSG"
    echo ""
    echo "# ^ AI-suggested commit message — edit freely, or delete and write your own."
    echo "# Lines starting with # are ignored by git."
    cat "$COMMIT_MSG_FILE"
} > "${COMMIT_MSG_FILE}.tmp"

mv "${COMMIT_MSG_FILE}.tmp" "$COMMIT_MSG_FILE"
